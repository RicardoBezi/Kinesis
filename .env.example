# Kinesis configuration. Copy to .env (never commit .env).
# Every setting is optional for local development and tests.

# --- Runtime ---------------------------------------------------------------
KINESIS_ENV=dev                      # dev | test | prod
KINESIS_LOG_LEVEL=INFO
KINESIS_DATA_DIR=./var               # job dirs, sqlite db, artifacts
KINESIS_MAX_UPLOAD_MB=200

# Redis is optional locally; when unset an in-process cache is used.
# docker compose sets this to redis://redis:6379/0
KINESIS_REDIS_URL=

# --- Blender worker --------------------------------------------------------
# Path to a Blender 4.5 LTS executable. `uv run task setup-blender` installs
# a portable copy into .tools/ and prints the path to put here.
KINESIS_BLENDER_BIN=
KINESIS_BLENDER_TIMEOUT_S=300

# --- Job runner --------------------------------------------------------------
KINESIS_JOB_RUNNER=local             # local | nebius

# --- Model provider ----------------------------------------------------------
# null  : no AI; deterministic fallback plan, evaluation SKIPPED
# mock  : canned responses (tests / demos without credentials)
# token_factory : Nebius Token Factory (OpenAI-compatible API)
KINESIS_PROVIDER=null

# Token Factory. Base URL and model IDs are NOT assumed stable:
# run `uv run task models` to list what your key can access (spike S4).
NEBIUS_API_KEY=
KINESIS_TF_BASE_URL=
KINESIS_PLANNER_MODEL=               # e.g. a Nemotron 3 Super model id
KINESIS_VISION_MODEL=                # e.g. a Nemotron 3 Nano Omni model id
KINESIS_CLASSIFIER_MODEL=            # e.g. a Nemotron Nano model id
KINESIS_TF_TIMEOUT_S=60

# --- Nebius Serverless Jobs (Phase 6) ----------------------------------------
NEBIUS_PROJECT_ID=
NEBIUS_JOB_IMAGE=

# --- Tests -------------------------------------------------------------------
# Live Nebius tests run only when this is exactly 1. Never set in CI by default.
KINESIS_LIVE_NEBIUS=0
