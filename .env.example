# Kinesis configuration. Copy to .env (never commit .env).
# Every setting is optional for local development and tests.

# --- Runtime ---------------------------------------------------------------
KINESIS_ENV=dev                      # dev | test | prod
KINESIS_LOG_LEVEL=INFO
KINESIS_DATA_DIR=./var               # job dirs, sqlite db, artifacts
KINESIS_MAX_UPLOAD_MB=200

# Redis is optional locally; when unset an in-process cache is used.
# docker compose sets this to redis://redis:6379/0
KINESIS_REDIS_URL=

# --- Blender worker --------------------------------------------------------
# Path to a Blender 4.5 LTS executable. `uv run task setup-blender` installs
# a portable copy into .tools/ and prints the path to put here.
KINESIS_BLENDER_BIN=
KINESIS_BLENDER_TIMEOUT_S=300

# --- Job runner --------------------------------------------------------------
KINESIS_JOB_RUNNER=local             # local | nebius

# --- Model provider ----------------------------------------------------------
# null  : no AI; deterministic fallback plan, evaluation SKIPPED
# mock  : canned responses (tests / demos without credentials)
# token_factory : Nebius Token Factory (OpenAI-compatible API)
KINESIS_PROVIDER=null

# Token Factory. The catalog changes over time, so run `uv run task models` to list
# what your key can currently access.
NEBIUS_API_KEY=
KINESIS_TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Verified by spike S4 on 2026-10-05: no Nemotron model on Token Factory accepts images.
# Vision model chosen by the bake-off of 2026-10-09 (docs/BENCHMARKS.md): GLM-5.3-Flash was
# the only model with no wrong answer, 100% valid JSON, and the lowest cost (~$0.001/review).
# At start-up an image-capable nvidia/* model, if ever listed, replaces it automatically.
KINESIS_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
KINESIS_VISION_MODEL=zai-org/GLM-5.3-Flash
KINESIS_CLASSIFIER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
KINESIS_TF_TIMEOUT_S=60

# --- Nebius Serverless Jobs (Phase 6) ----------------------------------------
# Used only with KINESIS_JOB_RUNNER=nebius (docs/PHASE6.md "To switch it on"). Live runs cost
# money; the runner refuses submissions over NEBIUS_BUDGET_USD and cancels any job running
# longer than NEBIUS_WATCHDOG_S. KINESIS_JOB_RUNNER=container runs the same image locally.
KINESIS_WORKER_IMAGE=kinesis-worker:4.5.14
NEBIUS_PROJECT_ID=
NEBIUS_JOB_IMAGE=                    # registry path of the pushed worker image
NEBIUS_RUNNER_MODE=job               # job (one Nebius job per step) | session (one per repair)
NEBIUS_REGION=us-central1
NEBIUS_PLATFORM=cpu-d3
NEBIUS_PRESET=4vcpu-16gb
NEBIUS_PREEMPTIBLE=false
NEBIUS_BUCKET=
NEBIUS_S3_ENDPOINT=https://storage.us-central1.nebius.cloud
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
NEBIUS_SERVICE_ACCOUNT_ID=
NEBIUS_AUTH_KEY_ID=
NEBIUS_AUTH_PEM=                     # path to the authorized key's private PEM (never the key itself)
NEBIUS_WATCHDOG_S=900
NEBIUS_BUDGET_USD=5
NEBIUS_PRICE_PER_HOUR_USD=           # for cost estimates and the budget guard

# --- Tests -------------------------------------------------------------------
# Live Nebius tests run only when this is exactly 1. Never set in CI by default.
KINESIS_LIVE_NEBIUS=0
